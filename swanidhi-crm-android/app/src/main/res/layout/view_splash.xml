<?xml version="1.0" encoding="utf-8"?>
<!-- Brand splash: deep navy (Zavtoo splash) so the navy + gold Swanidhi seal reads as drawn. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/glow_cyan" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/glow_white" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/splash_wave" />

    <LinearLayout
        android:id="@+id/splash_brand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <FrameLayout
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:background="@drawable/logo_ring"
            android:elevation="12dp"
            android:padding="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/splash_subtitle"
                android:src="@drawable/logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/poppins_extrabold"
            android:text="@string/splash_title"
            android:textColor="@android:color/white"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/splash_subtitle"
            android:textColor="@color/white_75"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/splash_motto"
            android:textColor="@color/gold"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splash_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/btn_get_started"
            style="@style/PrimaryButton.Gold"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/ButtonLabel"
                android:text="@string/get_started"
                android:textColor="@color/blue_dark" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right_navy" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/splash_loading"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/loading"
                android:textColor="@color/white_75"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
